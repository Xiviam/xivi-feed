NODE_ENV=production
PORT=3000
DATA_DIR=/app/data
DATABASE_PATH=/app/data/xivi.sqlite
SEED_DATABASE=false
CORS_ORIGIN=https://feed.xivici.space
PUBLIC_ORIGIN=https://feed.xivici.space
# Generate once for production: openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=replace-with-64-random-hex-characters
# Отдельный ключ, не используй значение от 2FA
CHAT_ENCRYPTION_KEY=replace-with-another-64-random-hex-characters
ADMIN_USERNAME=xivici
RESEND_API_KEY=re_replace_with_your_key
RESEND_FROM=XIVI <no-reply@xivici.space>
